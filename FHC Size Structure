#summarize data and add catch-curve variables
aged_summary <- final %>% 
  group_by(Year, ALKAge, Flood) %>% 
  summarize(count=length(ALKAge)) %>% 
  filter(ALKAge>2&ALKAge<16) %>% 
  ungroup() %>% 
  add_row(Year = 2024, ALKAge = 11, count = 0, Flood = "Pre") %>% #missing year of data in 2024
  rename(Age = ALKAge) %>% 
  arrange(Year, Age) %>% 
  mutate(YearClass = Year - Age, 
         count_adj = count+1,
         logcount = log(count_adj), 
         Year = as.factor(Year)); aged_summary %>% print(n=60)

# simulate priors
priors <- tibble(a = rnorm(100, 4, 2),
                 b = rnorm(100, -0.2, 0.2),
                 sigma = rexp(100, 1),
                 sim = 1:100)

# data (only the x values, since we're simulating y and mu and pretending we don't have them yet)
x <- aged_summary$Age

# combine and simulate
prior_and_x <- priors %>% expand_grid(x = x) %>%    # combine priors and x's
  mutate(mu = a + b*x ,                              # create new column call it mu- simulate regressions
         y = rnorm(nrow(.), mu, sigma))             # new column called y simulate data (e.g., y_rep)

# plot
prior_and_x %>% 
  ggplot(aes(x = x, y = mu, group = sim)) + 
  geom_line() +
  geom_point(data=aged_summary,aes(y = logcount, x=Age, group=NA)) +
  labs(y = "sim")

#Get prior
get_prior(logcount ~ Age*Year,
          data = aged_summary, family = gaussian())

# Unweighted regression of log(catch) ~ Age*Year
YCSmod <- brm(logcount ~ Age*Year,
              data = aged_summary ,
              family = gaussian(),
              prior = c(prior(normal(3, 2), class = "Intercept"),
                        prior(normal(-0.2, 0.2), class = "b"),
                        prior(exponential(1), class = "sigma")),
              file = "YCSmod.rds",
              iter=2000, chains=4,cores = 4)

summary(YCSmod)
plot(conditional_effects(YCSmod,re_formula=NULL), points = TRUE)
pp_check(YCSmod,type="boxplot",notch=FALSE)

#### getting mean predictions #####
post_res <- tibble(expand.grid(Age = seq(3,15,1), Year=as.factor(c(2018, 2022, 2023, 2024)))) %>% 
  add_epred_draws(YCSmod) %>% mean_qi(.epred)

#create weights from residual posterior expectations
ccbays_weight <- right_join(aged_summary, post_res %>% select(.epred, Age, Year), by=c("Age", "Year")) %>% 
  rename(weight=.epred)

########################
#weighted residual model --> weighting the regression by the predicted log(catch) values from YCSmod
#run weighted model
YCSmod_weight <- brm(logcount | weights(weight) ~ Age*Year, 
                     data = ccbays_weight,
                     family = gaussian(),
                     prior = c(prior(normal(3, 2), class = "Intercept"),
                               prior(normal(-0.2, 0.2), class = "b"),
                               prior(exponential(1), class = "sigma")),
                     file = "YCSmod_weight.rds",
                     iter=2000, chains=4,cores = 4)

summary(YCSmod_weight)
plot(conditional_effects(YCSmod_weight,re_formula=NULL), points = TRUE)
pp_check(YCSmod_weight,type="boxplot",notch=FALSE)
bayes_R2(YCSmod_weight)

