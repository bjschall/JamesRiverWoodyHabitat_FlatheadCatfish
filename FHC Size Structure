######################### Formula ################################
form_1 <- bf(Length ~ Linf *(1- exp(-K*(Age-t0))), #Von B Equation
             Linf ~ Year, #Year as a fixed effect
             K ~ Year,
             t0 ~ Year,
             nl = TRUE)

############prior Simulations############
priors = tibble(Linf = abs(rnorm(100, 1276, 50)),
                K = abs(rnorm(100,0.065 ,0.1)),
                t0 = rnorm(100, -0.469, 0.5),
                iter = 1:100)

prior_sims = priors %>% 
  expand_grid(Age_L %>% distinct(Age) %>% 
                bind_rows(tibble(Age = 0))) %>% 
  mutate(length_sims = Linf *(1- exp(-K*(Age-t0))))


ggplot() + 
  geom_line(data=prior_sims, aes(x = Age, y = length_sims, group = iter))+
  geom_point(data=Age_L,aes(x=Age, y=Length,color="red"))

##################### Model ########################
get_prior(form_1, data = Age_L, family = gaussian())

FHCVonYearModel <- brm(form_1 ,
                       data = Age_L,
                       prior = c(prior(normal(1276, 50), nlpar = "Linf"),
